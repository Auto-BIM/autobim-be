# Copy to deploy/.env (not committed). Values below are for the OCI VM.
# Laptop (Docker Desktop): HTTP_PORT=8080, HTTPS_PORT=8443, and MODELS_DIR / FE_DIR under
# your home directory (Docker Desktop does not share /opt by default). See deploy/README.md.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
MODELS_DIR=/opt/autobim/models
FE_DIR=/opt/autobim/fe
EXTRAS=
AUTOBIM_WALL_SEGMENTER=fake
AUTOBIM_OPENING_DETECTOR=fake
AUTOBIM_DIMENSION_READER=none

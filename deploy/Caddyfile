{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# Open only while debugging

      "SupplementRequest": {
        "additionalProperties": false,
        "description": "User-supplied corrections, applied to the stored Plan without re-running the models.\n\nOrder: scale -> walls -> openings -> add_walls -> add_openings -> resolved.\nExisting element IDs never change; added elements get new IDs.",
        "properties": {
          "add_openings": {
            "items": {
              "$ref": "#/components/schemas/NewOpening"
            },
            "title": "Add Openings",
            "type": "array"
          },
          "add_walls": {
            "items": {
              "$ref": "#/components/schemas/NewWall"
            },
            "title": "Add Walls",
            "type": "array"
          },
          "openings": {
